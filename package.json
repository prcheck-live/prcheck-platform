{
  "name": "qivvra-platform",
  "version": "0.1.0",
  "private": true,
  "description": "QIVVRA engine: independent change assurance for pull requests.",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "db:migrate": "tsx src/migrate.ts",
    "assess": "tsx src/cli.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
