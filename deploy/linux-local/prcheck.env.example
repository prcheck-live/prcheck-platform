# Copy to ~/prcheck/prcheck.env and fill in. Never commit the real file.

# Your GitHub organisation (github.com/<ORG>)
GH_ORG=ascendqe-demo

# Fine-grained personal access token used by the PRCheck.live engine, scoped to <ORG>/vendorpay-app only:
#   Repository permissions: Commit statuses = Read and write, Pull requests = Read and write,
#                           Issues = Read and write (PR comments), Contents = Read-only, Metadata = Read-only
PRCHECK_GITHUB_TOKEN=github_pat_xxx

# Shared secret between the GitHub webhook and the engine. Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=change-me

# Encrypts credentials an Admin enters in "Add application" (Jira token, test logins). openssl rand -hex 32
# Keep it: if it changes, stored credentials can no longer be read and must be entered again.
PRCHECK_SECRET_KEY=change-me
# Signs sign-in sessions, so they survive engine restarts. openssl rand -hex 32
PRCHECK_SESSION_SECRET=change-me

# Databases (created by setup.sh)
VENDORPAY_DATABASE_URL=postgres://vendorpay:vendorpay@localhost:5432/vendorpay
DATABASE_URL=postgres://prcheck:prcheck@localhost:5432/prcheck

# Public URL of the engine. Filled in automatically by start.sh from the tunnel.
PRCHECK_PUBLIC_URL=
